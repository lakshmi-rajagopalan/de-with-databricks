{
  "datasets": [
    {
      "name": "funnel_summary",
      "displayName": "1 · Funnel Summary",
      "query": "SELECT SUM(impressions) AS total_impressions, SUM(clicks) AS total_clicks, ROUND(SUM(clicks) / SUM(impressions) * 100, 2) AS overall_ctr_pct, COUNT(DISTINCT opening_uid) AS jobs_in_results FROM clickstream_dev.gold.job_performance_ctr"
    },
    {
      "name": "top_jobs_by_impressions",
      "displayName": "2 · Top 10 Jobs by Impressions",
      "query": "SELECT gp.title, j.category, j.budget_type, j.numeric_budget_amount, gp.impressions, gp.clicks, gp.ctr_pct, gp.avg_impression_position, gp.avg_click_time FROM clickstream_dev.gold.job_performance_ctr gp LEFT JOIN clickstream_dev.silver.job_openings j USING (opening_uid) WHERE gp.impressions IS NOT NULL ORDER BY gp.impressions DESC LIMIT 10"
    },
    {
      "name": "top_jobs_by_ctr",
      "displayName": "3 · Top 10 Jobs by CTR",
      "query": "SELECT gp.title, j.category, j.budget_type, j.numeric_budget_amount, gp.impressions, gp.clicks, gp.ctr_pct, gp.avg_impression_position FROM clickstream_dev.gold.job_performance_ctr gp LEFT JOIN clickstream_dev.silver.job_openings j USING (opening_uid) WHERE gp.impressions >= 5 ORDER BY gp.ctr_pct DESC LIMIT 10"
    },
    {
      "name": "position_bias",
      "displayName": "4 · Position Bias Curve",
      "query": "SELECT page_position, impressions, avg_click_time FROM clickstream_dev.gold.impression_position_ctr WHERE page_position <= 20 ORDER BY page_position"
    },
    {
      "name": "category_performance",
      "displayName": "5 · Category Performance",
      "query": "SELECT category, job_count, active_jobs, ROUND(avg_budget, 0) AS avg_budget, impressions, unique_visitors, clicks, ctr_pct FROM clickstream_dev.gold.category_performance WHERE category IS NOT NULL ORDER BY impressions DESC"
    },
    {
      "name": "category_ctr_vs_budget",
      "displayName": "6 · Category CTR vs Budget",
      "query": "SELECT category, ROUND(avg_budget, 0) AS avg_budget, ctr_pct, impressions FROM clickstream_dev.gold.category_performance WHERE category IS NOT NULL AND avg_budget IS NOT NULL"
    },
    {
      "name": "search_query_performance",
      "displayName": "7 · Search Query Performance",
      "query": "SELECT search_query, search_sessions, unique_visitors, unique_jobs_shown, impressions, clicks, ctr_pct FROM clickstream_dev.gold.search_query_performance WHERE search_query IS NOT NULL ORDER BY impressions DESC LIMIT 20"
    },
    {
      "name": "sublocation_performance",
      "displayName": "8 · Featured Jobs vs Search Results",
      "query": "SELECT sublocation, impressions, unique_visitors, unique_jobs, avg_position, clicks, ctr_pct, avg_click_time FROM clickstream_dev.gold.sublocation_performance ORDER BY sublocation"
    },
    {
      "name": "daily_trend",
      "displayName": "9 · Daily Trend",
      "query": "SELECT event_date, impressions, unique_visitors, search_sessions, unique_jobs_shown, clicks, ctr_pct, avg_click_time FROM clickstream_dev.gold.daily_metrics ORDER BY event_date"
    },
    {
      "name": "time_to_click",
      "displayName": "10 · Time-to-Click Distribution",
      "query": "SELECT CASE WHEN time_to_click_secs IS NULL THEN 'unknown' WHEN time_to_click_secs < 3 THEN '< 3s (instant)' WHEN time_to_click_secs < 10 THEN '3-10s' WHEN time_to_click_secs < 30 THEN '10-30s' WHEN time_to_click_secs < 60 THEN '30-60s' ELSE '> 60s' END AS latency_bucket, COUNT(*) AS clicks, ROUND(AVG(time_to_click_secs), 1) AS avg_secs FROM clickstream_dev.silver.click_events GROUP BY latency_bucket"
    },
    {
      "name": "budget_type_distribution",
      "displayName": "11 · Budget Type Distribution",
      "query": "SELECT j.budget_type, COUNT(*) AS job_count, ROUND(AVG(j.numeric_budget_amount), 2) AS avg_budget_amount, SUM(gp.impressions) AS total_impressions, ROUND(SUM(gp.clicks) / SUM(gp.impressions) * 100, 2) AS ctr_pct FROM clickstream_dev.silver.job_openings j LEFT JOIN clickstream_dev.gold.job_performance_ctr gp USING (opening_uid) WHERE j.budget_type IS NOT NULL GROUP BY j.budget_type ORDER BY job_count DESC"
    },
    {
      "name": "client_activity",
      "displayName": "12 · Client Activity Summary",
      "query": "SELECT j.client_uid, COUNT(DISTINCT j.opening_uid) AS jobs_posted, SUM(gp.impressions) AS total_impressions, SUM(gp.clicks) AS total_clicks, ROUND(SUM(gp.clicks) / SUM(gp.impressions) * 100, 2) AS avg_ctr_pct, ROUND(AVG(j.numeric_budget_amount), 2) AS avg_budget_amount FROM clickstream_dev.silver.job_openings j LEFT JOIN clickstream_dev.gold.job_performance_ctr gp USING (opening_uid) GROUP BY j.client_uid ORDER BY total_impressions DESC LIMIT 15"
    }
  ],
